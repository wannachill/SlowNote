.history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.history-list {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: var(--space-m) var(--space-m) calc(var(--space-m) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.history-swipe {
  position: relative;
  margin-bottom: var(--space-s);
  border-radius: var(--radius);
  overflow: hidden;
}
.history-swipe.swipe-open .swipe-actions {
  visibility: visible;
  pointer-events: auto;
}
.history-swipe .swipe-actions {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
  width: calc(var(--swipe-action-width) / 2);
  border-radius: 0 var(--radius) var(--radius) 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
}
.history-swipe .swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-xs);
  border-radius: 0;
  color: var(--color-on-accent);
  font-size: var(--font-caption);
}
.history-swipe .delete-action { background: var(--color-notice); }
.history-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-s);
  padding: var(--space-sm) var(--space-m);
  border: var(--border-width) solid transparent;
  border-radius: var(--radius);
  background: var(--color-surface);
  transition: transform var(--motion-feedback) var(--curve-spring);
}
.history-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}
.history-item-title {
  color: var(--color-text-1);
  font-size: var(--font-body);
  font-weight: var(--weight-medium);
  line-height: var(--line-body);
  overflow-wrap: anywhere;
}
.history-item-time {
  color: var(--color-text-2);
  font-size: var(--font-caption);
}
.history-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-s);
  padding: var(--space-xl);
  text-align: center;
}
.history-state .skeleton-list { width: 100%; text-align: left; }
.history-empty-title {
  color: var(--color-text-1);
  font-size: var(--font-title);
}
.history-empty-hint {
  color: var(--color-text-3);
  font-size: var(--font-body);
  line-height: var(--line-body);
}
