<view class="theme-root {{themeClass}} history-page">
  <view class="sub-nav" style="height: calc({{statusBarHeight}}px + var(--nav-height)); padding-top: {{statusBarHeight}}px;"><button class="sub-nav-back" bindtap="goBack" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-label="返回"></button><text class="sub-nav-title">历史对话</text><view class="sub-nav-spacer" aria-hidden="true"></view></view>
  <view wx:if="{{loading && !list.length}}" class="history-state skeleton-loading" role="status"><text class="loading-copy">正在加载历史对话…</text><view class="skeleton-list"><view wx:for="{{[0,1,2]}}" wx:key="*this" class="skeleton-card"><view class="skeleton-line short"></view><view class="skeleton-line"></view></view></view></view>
  <view wx:elif="{{error}}" class="history-state" role="alert"><text class="history-empty-hint">{{error}}</text><button class="btn-secondary" bindtap="load" hover-class="tap-feedback">重试</button></view>
  <view wx:elif="{{!list.length}}" class="history-state"><text class="history-empty-title">还没有历史对话</text><text class="history-empty-hint">去小迈页提问，对话自动保存。</text></view>
  <scroll-view wx:else class="history-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{list}}" wx:key="sessionId" class="history-swipe {{item.swipeX ? 'swipe-open' : ''}}" data-id="{{item.sessionId}}">
      <view class="swipe-actions">
        <button class="swipe-action delete-action" data-id="{{item.sessionId}}" catchtap="onRemove" hover-class="tap-feedback" hover-stop-propagation="{{true}}" hover-start-time="20" hover-stay-time="60" aria-label="删除对话{{item.title}}">删除</button>
      </view>
      <view class="history-item" data-id="{{item.sessionId}}" style="transform: translate({{item.swipeX}}px, 0);" bindtap="onSelect" bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd" bindtouchcancel="onCardTouchEnd" hover-class="tap-feedback" hover-stop-propagation="{{true}}" hover-start-time="20" hover-stay-time="60" role="button" aria-label="查看对话{{item.title}}">
        <view class="history-item-main"><text class="history-item-title">{{item.title}}</text><text class="history-item-time">{{item.timeText}}</text></view>
      </view>
    </view>
  </scroll-view>
  <include src="../../templates/motion-confirm.wxml" />
</view>
