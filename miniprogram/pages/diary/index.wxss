.compose {
  display: flex;
  flex-direction: column;
}
.compose-input {
  display: block;
  width: 100%;
  min-height: var(--compose-height);
  padding: 0;
  color: var(--color-text-1);
  font-size: var(--font-body);
  line-height: var(--line-body);
}
.compose-actions {
  margin-top: var(--space-sm);
}
.image-preview {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}
.thumb-wrap, .thumb-add {
  position: relative;
  flex: 0 0 calc((100% - var(--space-xs) * 2) / 3);
  width: calc((100% - var(--space-xs) * 2) / 3);
  height: 0;
  padding-top: calc((100% - var(--space-xs) * 2) / 3);
  border-radius: var(--radius-small);
  background: var(--color-bg-soft);
}
.thumb {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-small);
  background: var(--color-bg-soft);
}
.thumb-remove {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--control-height);
  height: var(--control-height);
  border-radius: 0 var(--radius-small) 0 var(--radius-small);
  background: transparent;
  color: transparent;
  font-size: var(--font-title);
}
.thumb-add {
  color: var(--color-text-2);
}
.thumb-remove::before {
  content: '×';
  position: absolute;
  top: var(--space-xs);
  right: var(--space-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--space-l);
  height: var(--space-l);
  border-radius: var(--radius-round);
  background: var(--color-media-mask);
  color: var(--color-media-text);
}
.thumb-add::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: var(--border-width) dashed var(--color-text-2);
  border-radius: var(--radius-small);
  pointer-events: none;
}
.thumb-add-plus {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-heading);
  font-weight: var(--weight-regular);
}
.thumb-add-plus::before, .thumb-add-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--icon-size);
  height: var(--stroke-strong);
  border-radius: var(--radius-pill);
  background: currentColor;
  transform: translate(-50%, -50%);
}
.thumb-add-plus::after { transform: translate(-50%, -50%) rotate(calc(var(--icon-angle) * 2)); }
.compose-btn {
  margin-top: var(--space-m);
}
.compose-cancel { margin-top: var(--space-xs); }
.day-heading {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin: var(--space-l) 0 var(--space-xs);
}
.day-date {
  flex-shrink: 0;
  color: var(--color-text-2);
  font-size: var(--font-caption);
}
.day-heading .divider {
  flex: 1;
}
.diary-record-desc { display: block; }
.entry-content {
  display: block;
  color: var(--color-text-1);
  font-size: var(--font-body);
  line-height: var(--line-body);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.entry-images {
  align-items: flex-start;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-s);
}
.entry-image {
  display: block;
  width: calc((100% - var(--space-xs) * 2) / 3);
  height: var(--diary-image-size);
  min-width: var(--nav-height);
  min-height: var(--nav-height);
  border-radius: var(--radius-small);
  background: var(--color-bg-soft);
}
.page {
  padding-top: 0;
}
page { background: transparent; }
