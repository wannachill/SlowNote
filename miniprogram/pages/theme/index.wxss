.page {
  padding-top: 0;
}
.setting-card { padding-top: var(--space-xs); padding-bottom: var(--space-xs); }
.setting-card > .form-note { margin-bottom: var(--space-s); }
.theme-color-row { border-bottom: 0; }
.theme-color-switch { display: flex; align-items: center; flex: 0 0 auto; gap: var(--space-s); }
.theme-color-dot {
  width: calc(var(--control-height) - var(--space-s));
  height: calc(var(--control-height) - var(--space-s));
  padding: 0;
  border: var(--border-width) solid var(--color-divider);
  border-radius: var(--radius-round);
  background: transparent;
  box-shadow: none;
  transition: transform var(--motion-press) var(--curve-spring), border-color var(--motion-press) var(--curve-spring);
}
.theme-color-dot::after { border: 0; }
.theme-color-dot.active {
  border: var(--stroke-strong) solid var(--color-text-1);
  transform: scale(1.08);
}
