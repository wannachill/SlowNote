<view class="theme-root {{themeClass}} motion-host {{panelMode ? 'panel-host' : ''}}">
<view wx:if="{{!panelMode && !entryPending}}" class="motion-scene {{panel ? 'scene-mounted' : ''}} {{panel && !closing ? 'scene-recessed' : ''}} theme-root {{themeClass}} page">
  <view class="sub-nav" style="height: calc({{statusBarHeight}}px + var(--nav-height)); padding-top: {{statusBarHeight}}px;"><button class="sub-nav-back" bindtap="goBack" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-label="返回"></button><text class="sub-nav-title">喂养记录</text><view class="sub-nav-spacer" aria-hidden="true"></view></view>
  <net-banner />
  <view class="summary feeding-summary">
    <text class="summary-count">{{todayRecords.length}}</text>
    <text class="summary-label">当日记录</text>
  </view>
  <picker disabled="{{submitting || closing}}" mode="date" value="{{recordDate}}" end="{{today}}" bindchange="onDate" aria-label="喂养记录日期"><view class="select-value record-date-select pressable" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}"><text>{{recordDate}}</text><view class="chevron" aria-hidden="true"></view></view></picker>
  <view wx:if="{{!cardEditMode}}" class="quick">
    <view class="quick-btn quick-primary pressable motion-primary {{motionRippleId === 'motion-feeding-1' ? 'ripple-' + motionRipplePhase : ''}}" data-panel="feed" bindtap="openPanel" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-role="button" aria-label="记录喂奶" id="motion-feeding-1" bindtouchstart="motionPress" style="{{motionRippleId === 'motion-feeding-1' ? motionRippleStyle : ''}}">
      <text class="quick-name">喂奶</text>
      <text class="quick-desc">亲喂、瓶喂、配方</text>
    </view>
  </view>

  <view class="card section history-card">
    <view class="section-heading"><text class="title">{{cardEditMode ? '选择要编辑的记录' : '历史记录'}}</text><text class="section-meta">{{todayRecords.length}} 条</text></view>
    <view wx:if="{{loading && !todayRecords.length}}" class="skeleton-loading" role="status"><view class="skeleton-list"><view wx:for="{{[0,1,2]}}" wx:key="*this" class="skeleton-card"><view class="skeleton-line short"></view><view class="skeleton-line"></view></view></view></view>
    <view wx:elif="{{loadError}}" class="status-block" role="alert"><text>{{loadError}}</text><button class="btn-secondary" bindtap="loadToday" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}">重试</button></view>
    <view wx:if="{{!todayRecords.length && !loading && !loadError}}" class="empty">
      <text class="empty-title">这一天的第一笔，从这里开始</text>
      <text class="empty-note">{{cardEditMode ? '当天暂无可编辑记录。' : '点上方喂奶，记下刚刚的喂养。'}}</text>
    </view>
    <view wx:for="{{todayRecords}}" wx:key="id" class="record pressable" data-id="{{item.id}}" bindtap="startEdit" hover-class="tap-feedback" aria-role="button" aria-label="编辑{{item.desc}}">
      <text class="record-time">{{item.time}}</text>
      <text class="record-desc">{{item.desc}}</text>
    </view>
  </view>

</view>
  <view wx:if="{{panel === 'feed'}}" class="theme-root {{themeClass}} mask {{panelMode ? 'registration-fullscreen' : ''}} {{closing ? 'closing' : ''}}" style="--registration-status-bar-height: {{statusBarHeight}}px;" bindtap="closePanel">
    <view class="sheet sheet-feed {{closing ? 'closing' : ''}}">
      <view class="sheet-heading">
        <text class="sheet-title">喂奶记录</text>
        <button class="sheet-close" disabled="{{submitting || closing}}" bindtap="closePanel" aria-label="{{panelMode ? '返回首页' : '关闭喂奶记录'}}" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}">关闭</button>
      </view>
      <scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop">
      <view class="sheet-content">
        <net-banner wx:if="{{panel}}" />
        <view wx:if="{{cardEditMode && loading}}" class="record-lookup-status" role="status">正在读取当天喂养记录…</view>
        <view wx:if="{{cardEditMode && loadError}}" class="record-lookup-error" role="alert"><text>{{loadError}}</text><button class="text-action" bindtap="loadToday" hover-class="tap-feedback">重试</button></view>
        <view wx:if="{{panelMode}}" class="field"><text class="field-label">记录日期</text><picker disabled="{{submitting || closing}}" mode="date" value="{{recordDate}}" end="{{today}}" bindchange="onDate" aria-label="喂养记录日期"><view class="select-value pressable" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}"><text>{{recordDate}}</text><view class="chevron" aria-hidden="true"></view></view></picker></view>
        <view class="field">
          <text class="field-label">喂养方式</text>
          <view class="type-row">
            <view wx:for="{{feedTypes}}" wx:key="key" class="type-btn {{feedType === item.key ? 'active' : ''}} pressable {{motionChoiceGroup === 'feed' ? (index === motionChoiceIndex ? 'choice-pop' : index < motionChoiceIndex ? 'choice-left' : 'choice-right') : ''}}" data-type="{{item.key}}" data-motion-group="feed" data-motion-index="{{index}}" bindtouchstart="motionChoose" bindtap="selectType" hover-class="{{cardEditMode && loading ? 'none' : 'tap-feedback'}}" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-role="button" aria-label="{{item.name}}{{feedType === item.key ? '，已选中' : ''}}">{{item.name}}</view>
          </view>
        </view>
        <view class="field {{(feedType === 'breast' ? fieldErrors.duration : fieldErrors.amount) ? 'field-invalid' : ''}} {{fieldShake === (feedType === 'breast' ? 'duration' : 'amount') ? 'field-shake' : ''}}">
          <text class="field-label">{{feedType === 'breast' ? '亲喂时长' : '奶量'}}</text>
          <view class="field-input">
            <input disabled="{{submitting || closing || (cardEditMode && loading)}}" type="digit" class="input numeric-input" data-field="{{feedType === 'breast' ? 'duration' : 'amount'}}" placeholder="填写数值" placeholder-class="input-placeholder" value="{{feedType === 'breast' ? duration : amount}}" bindinput="onInput" aria-label="{{feedType === 'breast' ? '亲喂时长，分钟' : '奶量，毫升'}}" />
            <text class="unit">{{feedType === 'breast' ? '分钟' : 'ml'}}</text>
          </view>
          <text wx:if="{{refHint}}" class="field-hint">{{refHint}}</text>
          <text wx:if="{{feedType === 'breast' ? fieldErrors.duration : fieldErrors.amount}}" class="field-error" role="alert">{{feedType === 'breast' ? fieldErrors.duration : fieldErrors.amount}}</text>
        </view>
        <button class="btn-primary motion-primary {{motionRippleId === 'motion-feeding-2' ? 'ripple-' + motionRipplePhase : ''}}" bindtap="submitFeed" loading="{{submitting}}" disabled="{{submitting || closing || (cardEditMode && (loading || loadError))}}" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" id="motion-feeding-2" bindtouchstart="motionPress" style="{{motionRippleId === 'motion-feeding-2' ? motionRippleStyle : ''}}">{{submitting ? (editingId ? '更新中' : '记录中') : (editingId ? '更新' : '记录')}}</button>
      </view>
      </scroll-view>
    </view>
  </view>
</view>
