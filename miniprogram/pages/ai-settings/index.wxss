.page { padding-top: 0; }
.settings-page .setting-card > .title { display: block; margin-bottom: var(--space-s); }
.settings-content { padding-bottom: calc(var(--control-height) + var(--space-m) * 2 + env(safe-area-inset-bottom)); }
.settings-group { margin-top: var(--space-m); }
.settings-group:first-child { margin-top: var(--space-s); }
.settings-group-title { display: block; margin: 0 var(--space-xs) var(--space-xs); color: var(--color-text-3); font-size: var(--font-caption); }
.settings-section-card { margin-top: 0; padding-top: var(--space-xs); padding-bottom: var(--space-xs); overflow: hidden; }
.settings-entry {
  width: 100%;
  min-height: var(--input-height);
  gap: var(--space-s);
  padding: var(--space-sm) 0;
  border: 0;
  border-bottom: var(--border-width) solid var(--color-divider);
  background: transparent;
  color: var(--color-text-1);
  text-align: left;
}
.settings-entry:last-child { border-bottom: 0; }
.settings-entry::after { border: 0; }
.settings-entry-copy { flex: 1; min-width: 0; }
.settings-entry-name { display: block; color: var(--color-text-1); font-size: var(--font-body); }
.settings-entry-note { display: block; margin-top: var(--space-xs); color: var(--color-text-2); font-size: var(--font-caption); line-height: var(--line-body); }
.settings-entry-value { flex-shrink: 0; max-width: 27%; color: var(--color-text-3); font-size: var(--font-caption); text-align: right; overflow-wrap: anywhere; }
.settings-entry .chevron { flex-shrink: 0; color: var(--color-text-3); }
.settings-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--layer-tab);
  display: flex;
  gap: var(--space-s);
  padding: var(--space-s) var(--space-m) calc(var(--space-s) + env(safe-area-inset-bottom));
  border-top: var(--border-width) solid var(--color-divider);
  background: var(--color-bg);
}
.settings-dock .btn-secondary, .settings-dock .btn-primary { flex: 1; min-width: 0; white-space: nowrap; }
.form-note { display: block; margin-bottom: var(--space-s); }
.ai-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-m);
  min-height: var(--input-height);
  padding: var(--space-s) 0;
  border-bottom: var(--border-width) solid var(--color-divider);
}
.ai-setting-row:last-child { border-bottom: 0; }
.ai-setting-row switch { display: flex; align-items: center; flex: 0 0 auto; min-width: var(--control-height); min-height: var(--control-height); }
.ai-setting-copy { flex: 1; min-width: 0; }
.ai-setting-name { display: block; color: var(--color-text-1); font-size: var(--font-body); }
.ai-setting-note { display: block; margin-top: var(--space-xs); color: var(--color-text-2); font-size: var(--font-caption); line-height: var(--line-body); }
.prompt-field { margin-top: var(--space-m); }
.prompt-label { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); margin-bottom: var(--space-xs); color: var(--color-text-1); font-size: var(--font-caption); }
.prompt-custom { flex-shrink: 0; color: var(--color-accent-ink); }
.prompt-help { display: block; margin-bottom: var(--space-xs); color: var(--color-text-2); font-size: var(--font-caption); line-height: var(--line-body); }
.prompt-editor {
  display: block;
  width: 100%;
  min-height: var(--control-height);
  padding: var(--space-s);
  border: var(--border-width) solid var(--color-divider);
  border-radius: var(--radius-small);
  background: var(--color-field);
  color: var(--color-text-1);
  font-size: var(--font-body);
  line-height: var(--line-body);
  overflow-wrap: anywhere;
}
.prompt-count { display: block; margin-top: var(--space-xs); color: var(--color-text-3); font-size: var(--font-caption); text-align: right; }
.settings-error { margin: var(--space-s) var(--space-m); color: var(--color-text-2); font-size: var(--font-caption); line-height: var(--line-body); }
.settings-loading { padding: var(--space-m); color: var(--color-text-2); font-size: var(--font-caption); }
.safety-heading { display: flex; align-items: center; gap: var(--space-s); }
.safety-heading .title { margin: 0; }
.safety-note { display: block; margin: var(--space-xs) 0 var(--space-s); color: var(--color-text-2); font-size: var(--font-caption); }
.safety-content { display: block; padding: var(--space-s); border-radius: var(--radius-small); background: var(--color-bg-soft); color: var(--color-text-2); font-size: var(--font-caption); line-height: var(--line-body); white-space: pre-wrap; overflow-wrap: anywhere; }
.settings-detail > .section-heading { margin-bottom: var(--space-sm); }
.question-swipe {
  position: relative;
  width: 100%;
  margin-bottom: var(--space-s);
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--color-surface);
  isolation: isolate;
}
.question-swipe-actions {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
  width: var(--swipe-action-width);
  border-radius: 0 var(--radius) var(--radius) 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
}
.question-swipe.swipe-open .question-swipe-actions { visibility: visible; pointer-events: auto; }
.question-swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  padding: 0 var(--space-xs);
  border-radius: 0;
  color: var(--color-on-accent);
  font-size: var(--font-caption);
}
.question-edit-action { background: var(--color-accent-ink); }
.question-delete-action { background: var(--color-notice); }
.question-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: var(--row-height);
  padding: var(--space-sm) var(--space-m);
  border-radius: 0;
  background: var(--color-surface);
  transition: transform var(--motion-quick) var(--curve-spring);
  will-change: transform;
}
.question-main { flex: 1 1 var(--entry-height); min-width: 0; }
.question-heading { display: flex; align-items: flex-start; gap: var(--space-s); }
.question-text { flex: 1; min-width: 0; color: var(--color-text-1); font-size: var(--font-body); font-weight: var(--weight-medium); line-height: var(--line-body); overflow-wrap: anywhere; }
.question-tag { flex: 0 0 auto; padding: 0 var(--space-xs); border-radius: var(--radius-small); background: var(--color-accent-soft); color: var(--color-accent-ink); font-size: var(--font-caption); font-weight: var(--weight-medium); line-height: var(--line-body); }
.question-range { margin-top: var(--space-xs); margin-bottom: 0; }
.question-empty { padding: var(--space-l) 0; color: var(--color-text-3); font-size: var(--font-body); text-align: center; }
.question-sheet { height: calc(var(--sheet-questions-height) + env(safe-area-inset-bottom)); }
.question-sheet-scroll { min-height: 0; }
.question-editor { box-sizing: border-box; }
.question-pin-row { margin-bottom: var(--space-s); }
.question-categories-field { margin-bottom: var(--space-m); }
.question-category-heading { display: flex; align-items: center; justify-content: space-between; }
.question-category-heading .field-label { margin-bottom: var(--space-s); }
.question-all-action { padding: 0; margin-bottom: var(--space-s); color: var(--color-accent-ink); font-size: var(--font-caption); line-height: var(--line-body); }
.question-category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xs); }
.question-category-hint { display: block; margin-top: var(--space-s); margin-bottom: 0; }
.questions-hint.subscribe-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
  background: var(--color-accent-soft);
  border-left: var(--hint-bar-width) solid var(--color-accent-ink);
}
.questions-hint .subscribe-main {
  flex: 1 1 var(--entry-height);
  min-width: 0;
}
.questions-hint .subscribe-title {
  display: block;
  font-size: var(--font-body);
  font-weight: var(--weight-medium);
  color: var(--color-accent-ink);
  line-height: var(--line-heading);
}
.questions-hint .subscribe-note {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-2);
  font-size: var(--font-caption);
  line-height: var(--line-body);
  overflow-wrap: anywhere;
}
.questions-hint .subscribe-btn {
  flex: 0 0 auto;
  width: auto;
  padding: var(--space-sm);
}
