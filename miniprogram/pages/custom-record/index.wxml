<view wx:if="{{!panelMode && !entryPending}}" class="theme-root {{themeClass}} page"><view class="sub-nav" style="height: calc({{statusBarHeight}}px + var(--nav-height)); padding-top: {{statusBarHeight}}px;"><button class="sub-nav-back" bindtap="goBack" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-label="返回"></button><text class="sub-nav-title">自定义记录</text><view class="sub-nav-spacer" aria-hidden="true"></view></view><view wx:if="{{!cardEditMode}}" class="card">
  <view class="field"><text class="field-label">记录日期</text><picker disabled="{{submitting || closing}}" mode="date" value="{{recordDate}}" end="{{today}}" bindchange="onDate" aria-label="记录日期"><view class="select-value pressable" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}"><text>{{recordDate}}</text><view class="chevron" aria-hidden="true"></view></view></picker></view>
  <view class="field"><text class="field-label">记录名称</text><input disabled="{{submitting || closing}}" class="input" value="{{label}}" data-field="label" bindinput="onInput" maxlength="24" placeholder="如：午睡、第一次理发" placeholder-class="input-placeholder" aria-label="记录名称" /></view>
  <view class="field {{fieldErrors.value ? 'field-invalid' : ''}} {{fieldShake === 'value' ? 'field-shake' : ''}}"><text class="field-label">数值（选填）</text><input disabled="{{submitting || closing}}" class="input" type="digit" value="{{value}}" data-field="value" aria-describedby="custom-value-error" aria-invalid="{{!!fieldErrors.value}}" bindinput="onInput" placeholder="选填" placeholder-class="input-placeholder" aria-label="记录数值，选填" /><text wx:if="{{fieldErrors.value}}" id="custom-value-error" class="field-error" role="alert">{{fieldErrors.value}}</text></view>
  <view class="field"><text class="field-label">单位（选填）</text><input disabled="{{submitting || closing}}" class="input" value="{{unit}}" data-field="unit" bindinput="onInput" maxlength="6" placeholder="如：次、ml、g、kg、分钟" placeholder-class="input-placeholder" aria-label="单位，选填" /></view>
  <view class="field"><text class="field-label">备注（选填）</text><input disabled="{{submitting || closing}}" class="input" value="{{note}}" data-field="note" bindinput="onInput" maxlength="300" placeholder="还想记住什么？" placeholder-class="input-placeholder" aria-label="备注，选填" /></view>
  <button class="btn-primary motion-primary {{motionRippleId === 'motion-custom-record-1' ? 'ripple-' + motionRipplePhase : ''}}" bindtap="save" loading="{{submitting}}" disabled="{{submitting || closing}}" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" id="motion-custom-record-1" bindtouchstart="motionPress" style="{{motionRippleId === 'motion-custom-record-1' ? motionRippleStyle : ''}}">记录</button>
</view><view class="section"><text class="title">{{cardEditMode ? '选择要编辑的记录' : '这一天的记录'}}</text><view wx:if="{{loading && !records.length}}" class="status-block skeleton-loading" role="status"><text class="loading-copy">正在读取记录…</text><view class="skeleton-list"><view wx:for="{{[0,1]}}" wx:key="*this" class="skeleton-card"><view class="skeleton-line short"></view><view class="skeleton-line"></view></view></view></view><view wx:elif="{{error}}" class="status-block" role="alert"><text>{{error}}</text><button class="btn-secondary" bindtap="load" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}">重试</button></view><view wx:elif="{{!records.length}}" class="empty"><text class="empty-note">{{cardEditMode ? '当天暂无可编辑记录。' : '在上方记下第一笔。'}}</text></view><view wx:for="{{records}}" wx:key="_id" class="custom-entry pressable" data-id="{{item._id}}" bindtap="editRecord" hover-class="tap-feedback" aria-role="button" aria-label="编辑{{item.label}}"><text class="title">{{item.label}}{{item.value == null ? '' : ' ' + item.valueText + item.unit}}</text><text wx:if="{{item.note}}" class="form-note">{{item.note}}</text></view></view></view>
<view wx:if="{{panelMode}}" class="theme-root {{themeClass}} mask registration-fullscreen {{closing ? 'closing' : ''}}" style="--registration-status-bar-height: {{statusBarHeight}}px;" bindtap="closePanel"><view class="sheet {{closing ? 'closing' : ''}}"><view class="sheet-heading"><text class="sheet-title">自定义记录</text><button class="sheet-close" disabled="{{submitting || closing}}" bindtap="closePanel" aria-label="返回首页" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}">关闭</button></view><scroll-view class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop"><view class="sheet-content">
  <view wx:if="{{cardEditMode && loading}}" class="record-lookup-status" role="status">正在读取当天自定义记录…</view>
  <view wx:if="{{cardEditMode && error}}" class="record-lookup-error" role="alert"><text>{{error}}</text><button class="text-action" bindtap="load" hover-class="tap-feedback">重试</button></view>
  <view class="field"><text class="field-label">记录日期</text><picker disabled="{{submitting || closing || (cardEditMode && loading)}}" mode="date" value="{{recordDate}}" end="{{today}}" bindchange="onDate" aria-label="记录日期"><view class="select-value pressable" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}"><text>{{recordDate}}</text><view class="chevron" aria-hidden="true"></view></view></picker></view>
  <view class="field"><text class="field-label">项目</text><input disabled="{{submitting || closing || (cardEditMode && loading)}}" class="input" value="{{label}}" data-field="label" bindinput="onInput" maxlength="24" placeholder="自建项目名称" placeholder-class="input-placeholder" aria-label="自定义项目名称" /></view>
  <view class="field {{fieldErrors.value ? 'field-invalid' : ''}} {{fieldShake === 'value' ? 'field-shake' : ''}}"><text class="field-label">数值（选填）</text><input disabled="{{submitting || closing || (cardEditMode && loading)}}" class="input" type="digit" value="{{value}}" data-field="value" aria-describedby="custom-panel-value-error" aria-invalid="{{!!fieldErrors.value}}" bindinput="onInput" placeholder="选填" placeholder-class="input-placeholder" aria-label="记录数值，选填" /><text wx:if="{{fieldErrors.value}}" id="custom-panel-value-error" class="field-error" role="alert">{{fieldErrors.value}}</text></view>
  <view class="field"><text class="field-label">单位（选填）</text><input disabled="{{submitting || closing || (cardEditMode && loading)}}" class="input" value="{{unit}}" data-field="unit" bindinput="onInput" maxlength="6" placeholder="如：次、ml、g、kg、分钟" placeholder-class="input-placeholder" aria-label="单位，选填" /></view>
  <view class="field"><text class="field-label">备注（选填）</text><input disabled="{{submitting || closing || (cardEditMode && loading)}}" class="input" value="{{note}}" data-field="note" bindinput="onInput" maxlength="300" placeholder="还想记住什么？" placeholder-class="input-placeholder" aria-label="备注，选填" /></view>
  <button class="btn-primary motion-primary {{motionRippleId === 'motion-custom-record-1' ? 'ripple-' + motionRipplePhase : ''}}" bindtap="save" loading="{{submitting}}" disabled="{{submitting || closing || (cardEditMode && (loading || error))}}" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" id="motion-custom-record-1" bindtouchstart="motionPress" style="{{motionRippleId === 'motion-custom-record-1' ? motionRippleStyle : ''}}">{{submitting ? (editingId ? '更新中' : '记录中') : (editingId ? '更新' : '记录')}}</button>
</view></scroll-view></view></view>
