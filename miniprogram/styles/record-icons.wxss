/* 同一图形按容器缩放：九宫格 56rpx，数据卡以 40rpx 基础尺寸放大；颜色继承按钮。 */
.category-icon, .record-icon {
  position: relative;
  display: block;
  flex-shrink: 0;
  box-sizing: border-box;
  color: inherit;
}
.category-icon {
  --glyph-size: var(--category-icon-size);
  width: var(--category-icon-size);
  height: var(--category-icon-size);
  margin-bottom: var(--space-xs);
}
.line-icon.record-icon {
  --glyph-size: var(--icon-size);
  color: inherit;
}
.record-icon::before, .record-icon::after { display: none; }
.category-icon-part, .category-icon-part::before, .category-icon-part::after {
  position: absolute;
  display: block;
  box-sizing: border-box;
  color: inherit;
}
/* 亲喂：SVG 图标。 */
.icon-category-breast {
  background: currentColor;
  -webkit-mask: url("data:image/svg+xml;base64,") no-repeat center / contain;
  mask: url("data:image/svg+xml;base64,") no-repeat center / contain;
}
