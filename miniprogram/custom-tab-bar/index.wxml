<view wx:if="{{!hidden}}" class="theme-root {{themeClass}} tab-shell">
  <view class="tab-track {{tabMotionReady ? 'tab-track-ready' : ''}}">
    <button wx:for="{{tabs}}" wx:key="path" class="tab-item {{selected === index ? 'is-current' : ''}}" data-index="{{index}}" bindtap="switchTab" hover-class="tap-feedback" hover-start-time="20" hover-stay-time="60" hover-stop-propagation="{{true}}" aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}">
      <view class="tab-icon-wrap"><view class="tab-icon icon-{{item.icon}} {{selected === index && tabMotionReady ? 'tab-icon-arrive' : ''}}" aria-hidden="true"></view></view>
      <text>{{item.text}}</text>
    </button>
  </view>
</view>
