/* Explicit root classes override system media rules, including forced light/dark. */
.theme-root {
  --bg-mesh-base: var(--bg-mesh-base-light);
  --bg-mesh: var(--bg-mesh-light);
  --color-bg: #edf4fb;
  --color-bg-soft: #deebf6;
  --color-surface: #ffffff;
  --color-field: #f1f5f9;
  --color-text-1: #26343f;
  --color-text-2: #52687b;
  --color-text-3: #52687b;
  --color-divider: rgba(38, 52, 63, .12);
  --color-accent: #5b9bd5;
  --color-accent-ink: #2e6da6;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #245783;
  --color-accent-soft: rgba(91, 155, 213, .14);
  --color-on-accent: #ffffff;
  --color-mask: rgba(38, 52, 63, .48);
  --color-focus: #2e6da6;
  --color-series-secondary: #6e8296;
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-1);
}
.theme-root.mode-dark {
  --bg-mesh-base: var(--bg-mesh-base-dark);
  --bg-mesh: var(--bg-mesh-dark);
  --color-bg: #141d27;
  --color-bg-soft: #1d2a37;
  --color-surface: #1d2a37;
  --color-float: rgba(26, 26, 26, .96);
  --color-field: #243343;
  --color-text-1: #d9e4ee;
  --color-text-2: #8fa7bc;
  --color-text-3: #8fa7bc;
  --color-divider: rgba(217, 228, 238, .14);
  --color-accent: #6fa8dc;
  --color-accent-ink: #a8c8e8;
  --color-action: var(--color-accent);
  --color-action-pressed: #5b9bd5;
  --color-accent-soft: rgba(111, 168, 220, .16);
  --color-on-accent: #0e1720;
  --color-mask: rgba(10, 16, 22, .72);
  --color-focus: #a8c8e8;
  --color-series-secondary: #8fa7bc;
  --shadow-card: none;
}
/* 樱粉主题：沿用蓝调的柔和弥散渐变质感，仅把冷色替换为粉→玫瑰→丁香的暖色系。 */
.theme-root.theme-color-pink {
  --color-bg: #fdeff5;
  --color-bg-soft: #f9dde8;
  --color-accent: #f6a5c0;
  --color-accent-ink: #c2517e;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #a8436b;
  --color-accent-soft: rgba(226, 109, 156, .14);
  --color-on-accent: #ffffff;
  --color-focus: #c2517e;
  --bg-mesh-light:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(255, 138, 191, .24) 0%, rgba(255, 138, 191, .07) 40%, rgba(255, 138, 191, 0) 78%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(255, 196, 213, .34) 0%, rgba(255, 196, 213, .12) 45%, rgba(255, 196, 213, 0) 85%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(199, 158, 235, .22) 0%, rgba(199, 158, 235, .07) 45%, rgba(199, 158, 235, 0) 85%);
}
/* 暖橙主题：橙→蜜桃→珊瑚的暖色弥散渐变，与蓝/粉同一套质感。 */
.theme-root.theme-color-orange {
  --color-bg: #fdf3e7;
  --color-bg-soft: #faead7;
  --color-accent: #fbb36b;
  --color-accent-ink: #c9762c;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #a85f1e;
  --color-accent-soft: rgba(201, 118, 44, .14);
  --color-on-accent: #ffffff;
  --color-focus: #c9762c;
  --bg-mesh-light:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(255, 165, 92, .24) 0%, rgba(255, 165, 92, .07) 40%, rgba(255, 165, 92, 0) 78%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(255, 205, 148, .34) 0%, rgba(255, 205, 148, .12) 45%, rgba(255, 205, 148, 0) 85%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(255, 138, 110, .22) 0%, rgba(255, 138, 110, .07) 45%, rgba(255, 138, 110, 0) 85%);
}
/* 深色主题：复用蓝调暗色基调与暗色弥散渐变，作为独立主题色存在（不再有单独的明暗模式开关）。 */
.theme-root.theme-color-dark {
  --bg-mesh-base: var(--bg-mesh-base-dark);
  --bg-mesh: var(--bg-mesh-dark);
}
/* 薄荷绿主题：绿→薄荷→青的清新弥散渐变，与蓝/粉/橙同一套质感。 */
.theme-root.theme-color-mint {
  --color-bg: #eafbf3;
  --color-bg-soft: #d4f3e6;
  --color-accent: #79dab4;
  --color-accent-ink: #1e9d74;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #147a57;
  --color-accent-soft: rgba(31, 157, 116, .14);
  --color-on-accent: #ffffff;
  --color-focus: #1e9d74;
  --bg-mesh-light:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(95, 211, 168, .24) 0%, rgba(95, 211, 168, .07) 40%, rgba(95, 211, 168, 0) 78%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(143, 227, 201, .34) 0%, rgba(143, 227, 201, .12) 45%, rgba(143, 227, 201, 0) 85%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(120, 200, 180, .22) 0%, rgba(120, 200, 180, .07) 45%, rgba(120, 200, 180, 0) 85%);
}
/* 紫色主题：紫→薰衣草→丁香的柔美弥散渐变，与蓝/粉/橙同一套质感。 */
.theme-root.theme-color-purple {
  --color-bg: #f5effb;
  --color-bg-soft: #e9def6;
  --color-accent: #c2a8e8;
  --color-accent-ink: #7e57c2;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #6a3fa8;
  --color-accent-soft: rgba(126, 87, 194, .14);
  --color-on-accent: #ffffff;
  --color-focus: #7e57c2;
  --bg-mesh-light:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(169, 139, 224, .24) 0%, rgba(169, 139, 224, .07) 40%, rgba(169, 139, 224, 0) 78%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(201, 168, 232, .34) 0%, rgba(201, 168, 232, .12) 45%, rgba(201, 168, 232, 0) 85%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(186, 150, 220, .22) 0%, rgba(186, 150, 220, .07) 45%, rgba(186, 150, 220, 0) 85%);
}
.theme-root.mask { background: var(--color-mask); }
