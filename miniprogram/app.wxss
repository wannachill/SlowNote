@import "styles/record-icons.wxss";
@import "styles/motion.wxss";
/* 一迈一记：生长刻度。颜色、排版、间距与组件尺寸统一定义于此。 */
page, .theme-root {
  --bg-mesh-base-light: #ffffff;
  --bg-mesh-base-dark: #101923;
  --bg-mesh-light:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(89, 139, 253, .25) 0%, rgba(89, 139, 253, .08) 40%, rgba(89, 139, 253, 0) 78%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(154, 212, 203, .35) 0%, rgba(154, 212, 203, .12) 45%, rgba(154, 212, 203, 0) 85%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(53, 179, 201, .25) 0%, rgba(53, 179, 201, .07) 45%, rgba(53, 179, 201, 0) 85%);
  --bg-mesh-dark:
    radial-gradient(ellipse 120% 90% at -20% -10%, rgba(58, 86, 138, .42) 0%, rgba(58, 86, 138, .16) 40%, rgba(58, 86, 138, 0) 80%),
    radial-gradient(ellipse 115% 95% at 115% 32%, rgba(58, 96, 92, .40) 0%, rgba(58, 96, 92, .15) 45%, rgba(58, 96, 92, 0) 86%),
    radial-gradient(ellipse 125% 100% at 30% 115%, rgba(42, 86, 98, .40) 0%, rgba(42, 86, 98, .15) 45%, rgba(42, 86, 98, 0) 86%);
  --bg-mesh-base: var(--bg-mesh-base-light);
  --bg-mesh: var(--bg-mesh-light);
  --color-bg: #edf4fb;
  --color-bg-soft: #deebf6;
  --color-surface: #ffffff;
  --color-float: rgba(255, 255, 255, .92);
  --color-field: #f1f5f9;
  --color-text-1: #26343f;
  --color-text-2: #52687b;
  --color-text-3: #52687b;
  --color-divider: rgba(38, 52, 63, .12);
  --color-accent: #5b9bd5;
  --color-accent-ink: #2e6da6;
  --color-action: var(--color-accent-ink);
  --color-action-pressed: #245783;
  --color-accent-soft: rgba(91, 155, 213, .14);
  --color-on-accent: #ffffff;
  --color-mask: rgba(38, 52, 63, .48);
  --color-notice: #b42318;
  --color-notice-soft: rgba(180, 35, 24, .12);
  --color-on-notice: #ffffff;
  --color-trend-up: #188038;
  --color-trend-down: #b42318;
  --color-focus: #2e6da6;
  --font-family: -apple-system, "PingFang SC", "HarmonyOS Sans", "MiSans", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  --font-caption: 28rpx;
  --font-metric-compact: 24rpx;
  --font-body: 30rpx;
  --font-control: 32rpx;
  --font-title: 34rpx;
  --font-heading: 44rpx;
  --font-brand: 48rpx;
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  --line-tight: 1.25;
  --line-body: 1.6;
  --tracking-brand: 4rpx;
  --motion-sheet: 400ms;
  --motion-quick: 180ms;
  --motion-feedback: 350ms;
  --motion-chart: 700ms;
  --motion-setting: 300ms;
  --motion-error: 250ms;
  --scene-scale: .92;
  --choice-scale: 1.05;
  --choice-shift: 6rpx;
  --error-shift: 5rpx;
  --color-error: var(--color-accent-ink);
  --ripple-opacity: .18;
  --ripple-x: 50%;
  --ripple-y: 50%;
  --ripple-size: 100%;
  --reveal-x: 50%;
  --reveal-y: 50%;
  --reveal-radius: 150vmax;
  --curve-spring: cubic-bezier(0.32, 0.72, 0, 1);
  --shadow-card: none;
  --motion-card-shift: 200ms;
  --card-wiggle-angle: 2deg;
  --card-wiggle-duration: 300ms;
  --card-wiggle-delay: 0ms;
  --card-remove-scale: .8;
  --space-xs: 8rpx;
  --space-s: 16rpx;
  --space-sm: 24rpx;
  --space-m: 32rpx;
  --space-ml: 40rpx;
  --space-l: 48rpx;
  --reveal-shift: 24rpx;
  --reveal-blur: 12rpx;
  --space-xl: 64rpx;
  --radius: 32rpx;
  --swipe-action-width: 220rpx;
  --radius-small: 16rpx;
  --radius-sheet: 32rpx;
  --radius-icon: 16rpx;
  --radius-round: 50%;
  --border-width: 1rpx;
  --stroke-width: 2rpx;
  --hint-bar-width: 6rpx;
  --control-height: max(88rpx, 44px);
  --input-height: max(96rpx, 44px);
  --entry-height: 208rpx;
  --entry-primary-height: 184rpx;
  --icon-size: 40rpx;
  --icon-inset: 8rpx;
  --icon-half: 20rpx;
  --icon-small: 12rpx;
  --chevron-size: 12rpx;
  --ruler-width: 20rpx;
  --ruler-height: 80rpx;
  --ruler-short: 8rpx;
  --ruler-middle: 40rpx;
  --timeline-width: 112rpx;
  --rail-gutter: 32rpx;
  --rail-time-height: 40rpx;
  --chart-height: 320rpx;
  --chart-height-lg: 360rpx;
  --chart-pane-step: 180rpx;
  --confetti-canvas-height: 100vh;
  --confetti-particle-size: 12rpx;
  --sheet-max-height: 84vh;
  --sheet-feed-height: 720rpx;
  --sheet-form-height: 800rpx;
  --sheet-excretion-height: 896rpx;
  --opacity-disabled: .48;
  --opacity-pressed: .76;
  --press-scale: .98;
  --press-scale-primary: .96;
  --motion-press: 350ms;
  --tracking-heading: 0;
  --nav-side-width: 112rpx;
  --nav-edge-inset: var(--space-ml);
  --nav-height: max(88rpx, 44px);
  --tab-page-top: 128rpx;
  --nav-top: 0px;
  --avatar-size: 160rpx;
  --avatar-sheet-size: 132rpx;
  --avatar-row-size: 88rpx;
  --avatar-logo-size: 96rpx;
  --avatar-home-size: 72rpx;
  --radio-size: 28rpx;
  --radio-stroke: 3rpx;
  --chat-composer-max: 65%;
  --layer-sheet: 100;
  --layer-tab: 50;
  --tab-height: max(96rpx, 48px);
  --fab-size: max(112rpx, 56px);
  --calendar-inset: 4px;
  --calendar-cell-height: max(112rpx, 56px);
  --empty-mark-width: 112rpx;
  --empty-mark-height: 144rpx;
  --dot-size: 8rpx;
  --category-sheet-height: 800rpx;
  --chat-input-max: 240rpx;
  --chat-photo-size: 192rpx;
  --chat-tool-icon: 32rpx;
  --chat-footer-height: max(88rpx, 44px);
  --radius-pill: 999rpx;
  --stroke-strong: 3rpx;
  --glyph-size: var(--icon-size);
  --icon-angle: 45deg;
  --icon-angle-reverse: -45deg;
  --category-icon-size: 56rpx;
  --font-data: 52rpx;
  --font-code: 56rpx;
  --line-heading: 1.3;
  --tracking-code: 6rpx;
  --row-height: 144rpx;
  --quick-height: 168rpx;
  --stat-height: 200rpx;
  --compose-height: 184rpx;
  --diary-image-size: calc((750rpx - var(--space-m) * 2 - var(--timeline-width) - var(--space-sm) - var(--space-xs) * 2) / 3);
  --sheet-ai-tasks-height: 1180rpx;
  --sheet-questions-height: 1240rpx;
  --sheet-detail-height: 640rpx;
  --sheet-report-height: 900rpx;
  --sheet-join-height: 592rpx;
  --sheet-baby-height: 1080rpx;
  --wheel-row-height: max(88rpx, 44px);
  --wheel-window-height: max(440rpx, 220px);
  --wheel-perspective: 480rpx;
  --wheel-radius: 160rpx;
  --wheel-angle-near: 24deg;
  --wheel-angle-far: 48deg;
  --wheel-angle-near-reverse: -24deg;
  --wheel-angle-far-reverse: -48deg;
  --wheel-scale-near: .88;
  --wheel-scale-far: .72;
  --wheel-opacity-near: .68;
  --wheel-opacity-far: .34;
  --wheel-offset-rest: 0px;
  --color-media-text: #ffffff;
  --color-media-mask: rgba(23, 23, 23, .76);
  --color-series-secondary: #9a9a9a;
  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text-1);
  font-family: var(--font-family);
  font-size: var(--font-body);
  line-height: var(--line-body);
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg-mesh-base: var(--bg-mesh-base-dark);
    --bg-mesh: var(--bg-mesh-dark);
    --color-bg: #141d27;
    --color-bg-soft: #1d2a37;
    --color-surface: #1d2a37;
    --color-float: rgba(26, 26, 26, .96);
    --color-field: #243343;
    --color-text-1: #d9e4ee;
    --color-text-2: #8fa7bc;
    --color-text-3: #8fa7bc;
    --color-divider: rgba(217, 228, 238, .14);
    --color-accent-soft: rgba(111, 168, 220, .16);
    --color-accent-ink: #a8c8e8;
    --color-action: #6fa8dc;
    --color-action-pressed: #5b9bd5;
    --color-on-accent: #0e1720;
    --color-mask: rgba(10, 16, 22, .72);
    --color-series-secondary: #8fa7bc;
    --color-trend-up: #81c995;
    --color-trend-down: #ff8a80;
    --shadow-card: none;
  }
}
view, button, input, textarea, picker, scroll-view, image {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  font-variant-numeric: inherit;
  line-height: inherit;
  -webkit-tap-highlight-color: transparent;
}
button::after {
  border: 0;
}
input, textarea {
  min-width: 0;
  background: transparent;
  color: var(--color-text-1);
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: var(--line-body);
  font-variant-numeric: inherit;
}
.input-placeholder {
  color: var(--color-text-3);
  font-size: var(--font-body);
  font-weight: var(--weight-regular);
}
.page {
  padding: var(--space-l) var(--space-m) calc(var(--tab-height) + env(safe-area-inset-bottom));
}
.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: var(--space-m);
}
.title {
  display: block;
  font-size: var(--font-title);
  font-weight: var(--weight-medium);
  line-height: var(--line-tight);
}
.subtitle {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-2);
}
.page-heading {
  margin-bottom: var(--space-l);
}
/* 三个 Tab 页共用同一层不透明标题区背景：下边缘形成固定水平线，切换 Tab 不跳变。
   负 margin 抵消页面左右内边距使背景满宽，左右 padding 复位保证内容位置不变。 */
.page-top-heading {
  margin-right: calc(var(--space-m) * -1);
  margin-bottom: var(--space-m);
  margin-left: calc(var(--space-m) * -1);
  padding-right: var(--space-m);
  padding-left: var(--space-m);
  background: var(--color-bg);
}
.page-title {
  display: block;
  font-size: var(--font-heading);
  font-weight: var(--weight-semibold);
  line-height: var(--line-tight);
  letter-spacing: var(--tracking-heading);
}
.page-note {
  display: block;
  margin-top: var(--space-s);
  color: var(--color-text-2);
  font-size: var(--font-caption);
}
.section {
  margin-top: var(--space-l);
}
.section-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-s);
  margin-bottom: var(--space-sm);
}
.section-meta {
  color: var(--color-text-2);
  font-size: var(--font-caption);
}
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--control-height);
  padding: var(--space-s) var(--space-m);
  background: var(--color-action);
  color: var(--color-on-accent);
  border-radius: var(--radius-small);
  font-size: var(--font-control);
  font-weight: var(--weight-medium);
  gap: var(--space-s);
}
button.btn-primary[disabled] {
  background: var(--color-action);
  color: var(--color-on-accent);
  opacity: var(--opacity-disabled);
}
.tap-feedback {
  opacity: var(--opacity-pressed);
  transform: scale(var(--press-scale));
}
button, .pressable {
  transition: transform var(--motion-press) var(--curve-spring), background-color var(--motion-press) var(--curve-spring), color var(--motion-press) var(--curve-spring), opacity var(--motion-press) var(--curve-spring);
}
.btn-primary.tap-feedback, .record-fab.tap-feedback {
  transform: scale(var(--press-scale-primary));
  background: var(--color-action-pressed);
  opacity: 1;
}
.text-action.tap-feedback, .sheet-close.tap-feedback, .sub-nav-back.tap-feedback {
  transform: none;
  background: var(--color-accent-soft);
  color: var(--color-accent-ink);
  opacity: 1;
}
button[disabled].tap-feedback, button.btn-primary[disabled].tap-feedback {
  transform: none;
  opacity: var(--opacity-disabled);
}
button.btn-primary[disabled].tap-feedback {
  background: var(--color-action);
}
button:focus-visible, .nav-card:focus-visible, .type-btn:focus-visible, input:focus, textarea:focus, picker:focus-visible {
  outline: var(--stroke-width) solid var(--color-focus);
  outline-offset: var(--space-xs);
}
.divider {
  height: var(--border-width);
  background: var(--color-divider);
}
.chevron {
  display: block;
  flex-shrink: 0;
  width: calc(var(--chevron-size) * 1.7);
  height: calc(var(--chevron-size) * 1.7);
  background: currentColor;
  -webkit-mask: url("data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjI0IiB2aWV3Qm94PSIwIDAgMjQgMjQiIHdpZHRoPSIyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIiB4bWxuczp4bGluaz0iaHR0cDovL3d3dy53My5vcmcvMTk5OS94bGluayI+PHBhdGggZD0iTTEwIDIyTDAgMTJMMTAgMmwxLjc3NSAxLjc3NUwzLjU1IDEybDguMjI1IDguMjI1eiIgZmlsbD0iY3VycmVudENvbG9yIj48L3BhdGg+PC9zdmc+") no-repeat center / contain;
  mask: url("data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjI0IiB2aWV3Qm94PSIwIDAgMjQgMjQiIHdpZHRoPSIyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIiB4bWxuczp4bGluaz0iaHR0cDovL3d3dy53My5vcmcvMTk5OS94bGluayI+PHBhdGggZD0iTTEwIDIyTDAgMTJMMTAgMmwxLjc3NSAxLjc3NUwzLjU1IDEybDguMjI1IDguMjI1eiIgZmlsbD0iY3VycmVudENvbG9yIj48L3BhdGg+PC9zdmc+") no-repeat center / contain;
  transform: rotate(180deg);
}
/* 门框上的生长刻度，只在品牌起点使用。 */
.growth-mark {
  position: relative;
  padding-left: var(--space-ml);
}
.growth-mark::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: var(--ruler-width);
  height: var(--ruler-height);
  border-left: var(--stroke-width) solid var(--color-accent);
  border-top: var(--stroke-width) solid var(--color-accent);
  border-bottom: var(--stroke-width) solid var(--color-accent);
}
.growth-mark::after {
  content: '';
  position: absolute;
  top: var(--ruler-middle);
  left: 0;
  width: var(--ruler-short);
  border-top: var(--stroke-width) solid var(--color-accent);
}
/* 线性图标由原生 view 绘制。 */
.line-icon {
  position: relative;
  display: block;
  width: var(--icon-size);
  height: var(--icon-size);
  color: var(--color-text-2);
  flex-shrink: 0;
}
.line-icon::before, .line-icon::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}
.icon-feeding::before {
  left: var(--icon-inset);
  right: var(--icon-inset);
  top: var(--icon-inset);
  bottom: 0;
  border: var(--stroke-width) solid currentColor;
  border-radius: var(--radius-icon);
}
.icon-feeding::after {
  left: var(--icon-small);
  right: var(--icon-small);
  top: 0;
  height: var(--icon-inset);
  border: var(--stroke-width) solid currentColor;
  border-bottom: 0;
}
.icon-growth::before {
  left: var(--icon-inset);
  top: 0;
  bottom: 0;
  width: var(--icon-half);
  border: var(--stroke-width) solid currentColor;
}
.icon-growth::after {
  left: var(--icon-inset);
  top: var(--icon-small);
  width: var(--icon-small);
  height: var(--icon-small);
  border-top: var(--stroke-width) solid currentColor;
  border-bottom: var(--stroke-width) solid currentColor;
}
.icon-diary::before {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: var(--stroke-width) solid currentColor;
  border-radius: var(--radius-icon);
}
.icon-diary::after {
  left: var(--icon-small);
  top: var(--icon-small);
  right: var(--icon-inset);
  height: var(--icon-small);
  border-top: var(--stroke-width) solid currentColor;
  border-bottom: var(--stroke-width) solid currentColor;
}
.icon-family::before {
  left: 0;
  top: 0;
  width: var(--icon-half);
  height: var(--icon-half);
  border: var(--stroke-width) solid currentColor;
  border-radius: var(--radius-round);
}
.icon-family::after {
  right: 0;
  bottom: 0;
  width: var(--icon-half);
  height: var(--icon-half);
  border: var(--stroke-width) solid currentColor;
  border-radius: var(--radius-round);
}
/* 共享控件：页面负责排列，相同视觉参数只定义一次。 */
.btn-secondary, .btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--control-height);
  padding: var(--space-s) var(--space-m);
  border: var(--border-width) solid var(--color-divider);
  border-radius: var(--radius-small);
  background: var(--color-surface);
  color: var(--color-text-1);
  font-size: var(--font-control);
  font-weight: var(--weight-medium);
  gap: var(--space-s);
}
.btn-danger {
  background: transparent;
  color: var(--color-text-2);
}
.link-btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: var(--control-height);
  min-width: var(--control-height);
  padding: var(--space-s) 0 var(--space-s) var(--space-s);
  border-radius: var(--radius-small);
  background: transparent;
  color: var(--color-text-1);
  font-size: var(--font-body);
}
button[disabled] {
  opacity: var(--opacity-disabled);
}
.input {
  display: block;
  width: 100%;
  min-width: 0;
  height: var(--input-height);
  padding: 0 var(--space-sm);
  background: var(--color-field);
  border-radius: var(--radius-small);
  font-size: var(--font-control);
}
.field {
  margin-bottom: var(--space-m);
}
.field-label {
  display: block;
  margin-bottom: var(--space-s);
  font-size: var(--font-caption);
  color: var(--color-text-2);
}
.field-input {
  display: flex;
  align-items: center;
  min-height: var(--input-height);
  padding-right: var(--space-sm);
  border-radius: var(--radius-small);
  background: var(--color-field);
}
.numeric-input {
  flex: 1 1 0%;
  width: 0;
  font-size: var(--font-heading);
  font-weight: var(--weight-medium);
}
.feeding-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}
.summary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}
.summary-count {
  font-size: var(--font-heading);
  font-weight: var(--weight-medium);
  line-height: var(--line-tight);
}
.summary-label {
  margin-top: var(--space-s);
  color: var(--color-text-2);
  font-size: var(--font-caption);
}
.feeding-summary {
  box-sizing: border-box;
  width: 100%;
  flex-direction: row;
  align-items: baseline;
  justify-content: flex-end;
  gap: var(--space-s);
  margin-bottom: var(--space-sm);
}
.quick {
  display: flex;
  align-items: stretch;
  gap: var(--space-s);
}
.quick-btn {
  display: flex;
  flex: 1 1 0%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: var(--quick-height);
  padding: var(--space-sm) var(--space-xs);
  border: var(--border-width) solid transparent;
  border-radius: var(--radius);
  background: var(--color-surface);
}
.quick-primary {
  flex-grow: 1.25;
  border-color: var(--color-accent);
  background: var(--color-action);
  color: var(--color-on-accent);
}
.quick-name {
  font-size: var(--font-title);
  font-weight: var(--weight-medium);
  line-height: var(--line-heading);
}
.quick-desc {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(var(--font-caption) * var(--line-body) * 2);
  margin-top: var(--space-xs);
  color: var(--color-text-2);
  font-size: var(--font-caption);
  text-align: center;
}
.quick-primary.tap-feedback {
  transform: scale(var(--press-scale-primary));
  background: var(--color-action-pressed);
