  color: var(--color-text-3);
}
.record-date-select, .diary-date-select {
  margin-bottom: var(--space-m);
}
.select-arrow {
  transform: rotate(270deg);
  margin-right: var(--space-xs);
}
.select-arrow.up {
  transform: rotate(90deg);
}
.consent {
  display: flex;
  align-items: flex-start;
  gap: var(--space-s);
  min-height: var(--control-height);
  margin: var(--space-sm) 0;
}
.consent switch {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: var(--control-height);
  min-width: var(--control-height);
}
.consent text {
  flex: 1;
  min-width: 0;
  padding-top: var(--space-xs);
  font-size: var(--font-caption);
  color: var(--color-text-2);
}
.empty-illustration {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl) var(--space-m);
  text-align: center;
}
.empty-book {
  position: relative;
  width: var(--empty-mark-width);
  height: var(--empty-mark-height);
  margin-bottom: var(--space-m);
  background: currentColor;
  color: var(--color-text-2);
  -webkit-mask: url("data:image/svg+xml;base64,") no-repeat center / contain;
  mask: url("data:image/svg+xml;base64,") no-repeat center / contain;
}
.empty-illustration .text-action {
  margin-top: var(--space-sm);
  color: var(--color-accent-ink);
}
.icon-custom::before {
  top: var(--icon-half);
  left: var(--icon-inset);
  right: var(--icon-inset);
  border-top: var(--stroke-width) solid currentColor;
}
.icon-custom::after {
  top: var(--icon-inset);
  bottom: var(--icon-inset);
  left: var(--icon-half);
  border-left: var(--stroke-width) solid currentColor;
}
.sub-nav {
  position: sticky;
  top: 0;
  z-index: calc(var(--layer-tab) + 10);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--color-bg);
  flex-shrink: 0;
}
.sub-nav-back {
  -webkit-appearance: none;
  appearance: none;
  width: var(--nav-side-width);
  height: var(--nav-height);
  flex-shrink: 0;
  border-radius: var(--radius-small);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 0 0 var(--nav-edge-inset);
  background: transparent;
  background-color: transparent;
  box-shadow: none;
  border: none;
  color: var(--color-text-1);
}
.sub-nav-back[disabled] {
  background: transparent;
  opacity: 1;
}
.sub-nav-back::before {
  content: '';
  width: calc(var(--icon-size) * 0.7);
  height: calc(var(--icon-size) * 0.7);
  background: currentColor;
  -webkit-mask: url("data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjI0IiB2aWV3Qm94PSIwIDAgMjQgMjQiIHdpZHRoPSIyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIiB4bWxuczp4bGluaz0iaHR0cDovL3d3dy53My5vcmcvMTk5OS94bGluayI+PHBhdGggZD0iTTEwIDIyTDAgMTJMMTAgMmwxLjc3NSAxLjc3NUwzLjU1IDEybDguMjI1IDguMjI1eiIgZmlsbD0iY3VycmVudENvbG9yIj48L3BhdGg+PC9zdmc+") no-repeat center / contain;
  mask: url("data:image/svg+xml;base64,PHN2ZyBoZWlnaHQ9IjI0IiB2aWV3Qm94PSIwIDAgMjQgMjQiIHdpZHRoPSIyNCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIiB4bWxuczp4bGluaz0iaHR0cDovL3d3dy53My5vcmcvMTk5OS94bGluayI+PHBhdGggZD0iTTEwIDIyTDAgMTJMMTAgMmwxLjc3NSAxLjc3NUwzLjU1IDEybDguMjI1IDguMjI1eiIgZmlsbD0iY3VycmVudENvbG9yIj48L3BhdGg+PC9zdmc+") no-repeat center / contain;
}
.sub-nav-back::after {
  border: none;
}
.sub-nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: var(--font-heading);
  font-weight: var(--weight-bold);
  color: var(--color-text-1);
  letter-spacing: var(--tracking-heading);
  line-height: var(--line-tight);
}
.sub-nav-spacer {
  width: var(--nav-side-width);
  flex-shrink: 0;
}
/* 弹层复用现有 closing 状态，进出沿同一路径。 */
@keyframes overlay-reveal {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 克制的底部入场，与现有延迟卸载时长保持一致。 */
@keyframes sheet-reveal {
  0% { opacity: 0; transform: translateY(100%); }
  100% { opacity: 1; transform: translateY(0); }
}
/* 退出动画：与入场同路径（向下滑出），由 js 延迟卸载配合 .closing 类触发 */
.mask.closing { animation: overlay-out var(--motion-sheet) var(--curve-spring) both; }
.sheet.closing { animation: sheet-out var(--motion-sheet) var(--curve-spring) both; }
@keyframes overlay-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes sheet-out {
  0% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(100%); }
}
.page > .sub-nav {
  margin: 0 calc(var(--space-m) * -1) var(--space-sm);
}
.settings-page > .setting-card > .title { display: none; }
.settings-page > .sub-nav + .setting-card { margin-top: 0; }
.sub-nav-title, .baby-name { line-height: var(--line-heading); }
.settings-link { border-radius: 0; }
.settings-link:last-child { border-bottom: 0; }
.settings-name { min-width: 0; overflow-wrap: anywhere; }
.text-action { line-height: var(--line-body); }
.metric-number, .stat-num, input, .calendar-number { font-variant-numeric: tabular-nums; }
.form-note, .sheet-note, .empty-note, .metric-detail, .section-meta { line-height: var(--line-body); }
.setting-row:last-child { border-bottom: 0; }
.select-value .chevron, .settings-link .chevron { flex-shrink: 0; }
.text-action, .sheet-close, .btn-secondary, .btn-danger { min-width: var(--control-height); }
button[loading] { cursor: progress; }
button[disabled] { cursor: default; }
@media (prefers-reduced-motion: reduce) {
  .confetti-canvas { display: none; }
  .quick-primary.tap-feedback { transform: none; }
  button, .pressable {
    transition: none;
  }
  .tap-feedback, .btn-primary.tap-feedback, .record-fab.tap-feedback {
    transform: none;
  }
  .mask, .sheet, .mask.closing, .sheet.closing { animation: none; }
  .motion-scene { transition: none; }
  .scene-recessed { transform: none; }
  .ripple-a::after, .ripple-b::after,
  .record-fab.ripple-a .fab-plus, .record-fab.ripple-b .fab-plus,
  .content-arrived, .field-shake,
  .setting-flash::after, .choice-pop, .choice-left, .choice-right,
  .theme-front, .confirm-mask, .confirm-dialog,
  .confirm-mask.closing, .confirm-dialog.closing { animation: none; }
}
